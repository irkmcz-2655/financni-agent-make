                    {
                      "a": "{{length(ifempty(11.body._embedded.leads; emptyarray))}}",
                      "b": "1",
                      "o": "number:equal"
                    }
                  ]
                ]
              }
            },
            {
              "id": 14,
              "module": "amo-crm:MakeAPICall",
              "version": 2,
              "mapper": {
                "url": "/v4/leads/{{11.body._embedded.leads[1].id}}/notes",
                "method": "POST",
                "qs": [],
                "headers": [],
                "body": "[{\"note_type\": \"common\", \"params\": {\"text\": \"Záloha {{1.object.amount_total / 100}} Kč zaplacena přes Stripe, lead přesunut automaticky.\"}}]"
              },
              "parameters": {
                "__IMTCONN__": null
