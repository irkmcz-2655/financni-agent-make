              }
            },
            {
              "id": 16,
              "module": "google-sheets:addRow",
              "version": 2,
              "mapper": {
                "from": "drive",
                "mode": "select",
                "values": {
                  "0": "{{formatDate(now; \"DD.MM.YYYY HH:mm\"; \"Europe/Prague\")}}",
                  "1": "{{1.object.customer_details.name}}",
                  "2": "{{lower(1.object.customer_details.email)}}",
                  "3": "'{{1.object.customer_details.phone}}",
                  "4": "{{1.object.amount_total / 100}}",
                  "5": "{{1.object.id}}",
                  "6": "{{get(first(ifempty(first(map(ifempty(11.body._embedded.leads[1].custom_fields_values; emptyarray); \"values\"; \"field_id\"; YOUR_COURSE_FIELD_ID)); emptyarray)); \"value\")}}",
                  "7": "{{11.body._embedded.leads[1].responsible_user_id}}",
                  "8": "{{11.body._embedded.leads[1].price}}",
                  "9": "https://YOUR-ACCOUNT.kommo.com/leads/detail/{{11.body._embedded.leads[1].id}}",
                  "10": "shoda podle e-mailu"
                },
                "sheetId": "Zálohy",
                "spreadsheetId": "/YOUR_SPREADSHEET_ID",
                "includesHeaders": true,
                "insertDataOption": "INSERT_ROWS",
                "useColumnHeaders": false,
                "valueInputOption": "USER_ENTERED",
                "insertUnformatted": false
