                "method": "PATCH",
                "qs": [],
                "headers": [],
                "body": "{\"pipeline_id\": YOUR_PIPELINE_ID, \"status_id\": YOUR_STAGE_DEPOSIT_PAID_ID, \"tags_to_add\": [{\"name\": \"V tabulce Zálohy\"}]}"
              },
              "parameters": {
                "__IMTCONN__": null
              },
              "filter": {
                "name": "právě jeden podle e-mailu",
                "conditions": [
