                "body": "[{\"text\": \"OVĚŘIT shodu podle jména a připravit smlouvu: {{1.object.customer_details.name}} ({{lower(1.object.customer_details.email)}})\", \"complete_till\": {{formatDate(addHours(now; 2); \"X\")}}, \"entity_id\": {{22.body._embedded.leads[1].id}}, \"entity_type\": \"leads\", \"responsible_user_id\": YOUR_CRM_USER_ID}]"
              },
